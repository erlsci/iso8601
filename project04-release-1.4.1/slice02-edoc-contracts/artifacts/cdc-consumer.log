#!/usr/bin/env escript
main([BeamDir,PairsPath]) ->
    true = code:add_patha(BeamDir),
    {ok,[Pairs]} = file:consult(PairsPath),
    {_,Count} = lists:foldl(fun({Block,Expr,Expected},{State,N}) ->
        {Previous,OldBindings} = State,
        Bindings = case Previous =:= Block of true -> OldBindings; false -> erl_eval:new_bindings() end,
        {ok,Tokens,_} = erl_scan:string(Expr),
        {ok,AST} = erl_parse:parse_exprs(Tokens),
        {value,Value,NewBindings} = erl_eval:exprs(AST,Bindings),
        {ok,ETokens,_} = erl_scan:string(Expected ++ "."),
        {ok,Oracle} = erl_parse:parse_term(ETokens),
        io:format("block ~p expression ~s actual ~p expected ~p pass ~p~n",[Block,Expr,Value,Oracle,Value=:=Oracle]),
        true = Value =:= Oracle,
        {{Block,NewBindings},N+1}
    end,{{none,erl_eval:new_bindings()},0},Pairs),
    io:format("README literal examples passed ~p~n",[Count]).

