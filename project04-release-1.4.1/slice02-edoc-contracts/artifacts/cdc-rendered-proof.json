    ],
    "hour": [
      "Calendar-style hour component."
    ],
    "minute": [
      "Calendar-style minute component."
    ],
    "second": [
      "Calendar-style whole-second component. Datetime tuples separately permit floating-point seconds for fractional precision."
    ],
    "interval": [
      "One of four parsed interval shapes: concrete start/end, start/duration, duration/end, or unanchored duration. Bounds require a concrete anchor."
    ],
    "duration": [
      "Fixed-order duration fields: sign, years, months, days, hours, minutes and seconds. Values default to zero; sign is ",
