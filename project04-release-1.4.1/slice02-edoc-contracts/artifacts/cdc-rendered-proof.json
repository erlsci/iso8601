      ", ",
      "\"+\"",
      " or ",
      "\"-\"",
      "."
    ],
    "expanded_year": [
      "Astronomical year integer, including negative years; year 0 is 1 BCE and year -1 is 2 BCE."
    ],
    "expanded_datetime": [
      "Expanded calendar datetime; seconds may be floating point to retain a fractional part."
    ]
